{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Les couleurs sont des noms ANSI (magenta, cyan...) : elles suivent le thème
  // de kitty, donc avec Blazer ça sort en pastel, et ça suivra si tu changes de thème.
  "logo": {
    "type": "file",
    "padding": { "top": 1, "left": 1, "right": 3 },
    // $1 = couleur du dessin, $2 = détails (les yeux et la lune du chat)
    "color": { "1": "bright_magenta", "2": "yellow" }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "bright_cyan", "separator": "white" },
    "key": { "width": 14 },
    "bar": { "char": { "elapsed": "■", "total": "·" }, "width": 10 },
    "percent": { "type": ["bar", "num"] }
  },
  "modules": [
    { "type": "title", "format": "  {user-name}@{host-name}" },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "  os", "format": "{pretty-name}" },
    { "type": "kernel", "key": "  kernel", "format": "{release}" },
    { "type": "uptime", "key": "  uptime" },
    { "type": "packages", "key": "  paquets" },
    "break",
    { "type": "shell", "key": "  shell" },
    { "type": "terminal", "key": "  terminal" },
    { "type": "terminalfont", "key": "  police" },
    { "type": "editor", "key": "  éditeur" },
    "break",
    { "type": "cpu", "key": "  cpu", "format": "{name}" },
    { "type": "memory", "key": "  ram" },
    { "type": "disk", "key": "  disque", "folders": "/" },
    { "type": "battery", "key": "  batterie" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
